# ---------------------------------------------------------------------------
# Copy this file to .env, replace every "change-me" value, then export the file
# before starting the backend:
#   cp .env.example .env
#   set -a && . ./.env && set +a
# ---------------------------------------------------------------------------

# Docker Compose (3308/6380 avoid conflicts with a local MySQL/Redis)
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis

# Spring datasource (DB_PASSWORD must equal MYSQL_ROOT_PASSWORD)
DB_HOST=localhost
DB_PORT=3308
DB_NAME=muxin_scrm
DB_USERNAME=root
DB_PASSWORD=change-me-mysql

# Spring Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=change-me-redis

# Security: generate with `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# AI module: used to encrypt model API keys stored in MySQL
AI_ENCRYPT_KEY=change-me-ai-encrypt-key
AI_TIMEOUT_SECONDS=60
# Fall back to the Mock channel when the real model call fails
AI_FALLBACK_MOCK=true

# Optional integrations
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FILE_STORAGE_PATH=./uploads/
OSS_TYPE=local
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=public
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
